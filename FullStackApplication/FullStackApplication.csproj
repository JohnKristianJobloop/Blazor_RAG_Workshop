<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>db443925-bfdc-44de-afb8-55b2c831ce0c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="DatabaseContext/" />
    <Folder Include="Extentions/" />
    <Folder Include="Extentions/ServiceCollectionExtensions/" />
    <Folder Include="Extentions/VectorExtension/" />
    <Folder Include="Extentions/WebAppExtension/" />
    <Folder Include="Models/" />
    <Folder Include="Models/Entities/" />
    <Folder Include="Models/LanguageModels/" />
    <Folder Include="Models/Ollama/" />
    <Folder Include="Models/Ollama/Client/" />
    <Folder Include="Models/Ollama/Options/" />
    <Folder Include="Services/" />
    <Folder Include="Services/Seeders/" />
    <Folder Include="ViewModels/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Ollama" Version="1.15.0" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>

</Project>
